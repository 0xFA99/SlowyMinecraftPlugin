      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "say Server Chat Messages"
      }
    },
    {
      "label": {
        "text": "Server Hotbar Messages: ",
        "extra": [
          {
            "text": "ON",
            "color": "green"
          }
        ]
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "say Server Hotbar Messages"
      }
    },
    {
      "label": {
        "text": "Death Messages: ",
