    "text": "Chat Settings"
  },
  "pause": false,
  "after_action": "none",
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Public Chat: ",
        "extra": [
          {
            "text": "ON",
            "color": "green"
          }
        ]
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "say Public Chat"
      }
    },
    {
