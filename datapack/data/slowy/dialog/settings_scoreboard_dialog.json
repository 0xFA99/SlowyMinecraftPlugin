{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Scoreboard Settings"
  },
  "pause": false,
  "after_action": "none",
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Scoreboard: ",
        "extra": [
          {
            "text": "ON",
            "color": "green"
          }
        ]
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "/customsettings toggle scoreboard"
      }
    },
    {
      "label": {
        "text": "Show Money: ",
        "extra": [
          {
            "text": "ON",
            "color": "green"
          }
        ]
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "/customsettings toggle money"
      }
    },
    {
      "label": {
        "text": "Show Shards: ",
        "extra": [
          {
            "text": "ON",
            "color": "green"
          }
        ]
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "/customsettings toggle shards"
      }
    },
    {
      "label": {
        "text": "Show Kills: ",
        "extra": [
          {
            "text": "OFF",
            "color": "red"
          }
        ]
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "/customsettings toggle kills"
      }
    },
    {
      "label": {
        "text": "Show Deaths: ",
        "extra": [
          {
            "text": "OFF",
            "color": "red"
          }
        ]
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "/customsettings toggle deaths"
      }
    },
    {
      "label": {
        "text": "Show Playtime: ",
        "extra": [
          {
            "text": "ON",
            "color": "green"
          }
        ]
      },
      "width": 200,
      "action": {
        "type": "minecraft:run_command",
        "command": "/customsettings toggle playtime"
      }
    }
  ],
  "exit_action": {
    "label": {
      "translate": "gui.back"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "slowy:settings_dialog"
    },
    "width": 200
  }
}
