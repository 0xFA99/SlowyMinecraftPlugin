<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.slowy.core</groupId>
    <artifactId>SlowyCore2</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>SlowyCore2</name>
    <description>SlowyCore2 - Modern High-Performance Core Plugin for PaperMC 26.2 on Java 25 LTS</description>

    <properties>
        <!-- Java 25 Target Properties -->
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Server Environment Paths -->
        <server.dir>/jail/minecraft/server</server.dir>
        <libraries.dir>${server.dir}/libraries</libraries.dir>

        <!-- Build Plugins -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-shade-plugin.version>3.6.1</maven-shade-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    </properties>

    <!-- Hanya dependensi esensial yang aktif digunakan (Zero unused dependencies) -->
    <dependencies>
        <!-- Paper & Minecraft Platform (Provided by Paper Server) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-server</artifactId>
            <version>26.2</version>
            <scope>system</scope>
            <systemPath>${server.dir}/versions/26.2/paper-26.2.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api-custom</artifactId>
            <version>26.2</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/io/papermc/paper/paper-api/26.2.build.121-stable/paper-api-26.2.build.121-stable.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>5.2.0</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/net/kyori/adventure-api/5.2.0/adventure-api-5.2.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-key</artifactId>
            <version>5.2.0</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/net/kyori/adventure-key/5.2.0/adventure-key-5.2.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <version>5.2.0</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/net/kyori/adventure-text-minimessage/5.2.0/adventure-text-minimessage-5.2.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>5.2.0</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/net/kyori/adventure-text-serializer-legacy/5.2.0/adventure-text-serializer-legacy-5.2.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-plain</artifactId>
            <version>5.2.0</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/net/kyori/adventure-text-serializer-plain/5.2.0/adventure-text-serializer-plain-5.2.0.jar</systemPath>
        </dependency>

        <!-- Platform Type Definitions required by Paper/Bukkit API bytecode -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.6.0-jre</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/com/google/guava/guava/33.6.0-jre/guava-33.6.0-jre.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/com/google/code/gson/gson/2.14.0/gson-2.14.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>8.5.19</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/it/unimi/dsi/fastutil/8.5.19/fastutil-8.5.19.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-chat</artifactId>
            <version>1.21-R0.2</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/net/md-5/bungeecord-chat/1.21-R0.2-deprecated+build.21/bungeecord-chat-1.21-R0.2-deprecated+build.21.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>9.0.75</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/com/mojang/authlib/9.0.75/authlib-9.0.75.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>datafixerupper</artifactId>
            <version>10.0.21</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/com/mojang/datafixerupper/10.0.21/datafixerupper-10.0.21.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
            <version>4.2.15.Final</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/io/netty/netty-buffer/4.2.15.Final/netty-buffer-4.2.15.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-common</artifactId>
            <version>4.2.15.Final</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/io/netty/netty-common/4.2.15.Final/netty-common-4.2.15.Final.jar</systemPath>
        </dependency>

        <!-- Modern Logging (SLF4J API provided by PaperMC runtime) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/org/slf4j/slf4j-api/2.0.18/slf4j-api-2.0.18.jar</systemPath>
        </dependency>

        <!-- Database Engine: HikariCP (Bundled) & SQLite JDBC (Server Library) -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.2.1</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.49.1.0</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/org/xerial/sqlite-jdbc/3.49.1.0/sqlite-jdbc-3.49.1.0.jar</systemPath>
        </dependency>

        <!-- Nullability Annotations -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${libraries.dir}/org/jspecify/jspecify/1.0.0/jspecify-1.0.0.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <!-- Strict JDK 25 LTS Enforcer -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-java-25</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>Kompilasi SlowyCore2 wajib menggunakan JDK 25 LTS!</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compiler Java 25 Full Configuration -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>25</release>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-classfile</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Jar Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
            </plugin>

            <!-- Shade Plugin: Bundling & Relocating HikariCP -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>dev.slowy.core.libs.hikari</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <!-- Resource Filtering agar placeholder ${project.version} di plugin.yml terbaca -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/plugin.yml</include>
                    <include>**/paper-plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/plugin.yml</exclude>
                    <exclude>**/paper-plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
